# 完整接口根地址，包含实际前缀；如果后端没有 /api，则去掉它。
PREDICTION_BASE_URL=https://your-host/api
# 裸 token 或 Bearer <token>；配置邮箱和密码后可留空，启动时自动登录。
PREDICTION_AUTHORIZATION=
# 401 时使用下面的账号密码重新登录。两项必须一起填写，实际 .env 不应入库。
PREDICTION_EMAIL=
PREDICTION_PASSWORD=
PREDICTION_WALLET_ID=1b7a77e7-3a71-4a76-ad28-b9c0bd9b9e2d
PREDICTION_AMOUNT=10
PREDICTION_STOP_PRICE=0.1
# 起始市场的下一个区间是最早下单市场；过期区间自动跳过，在区间开始后 1 分钟下单。
PREDICTION_SLUG=btc-updown-5m-1791787500
PREDICTION_PROJECT_ID=816d6686-3c64-4a98-bf41-9e781b77270e
